'{{env_name}}':
  host: appserver.{{env_label}}.{{site_id}}.drush.in
  paths:
    files: files
  uri: {% if custom_uri is defined %}{{custom_uri}}{% else %}{{env_label}}-{{site_name}}.pantheonsite.io{% endif %}

  user: {{env_label}}.{{site_id}}
  ssh:
    options: '-p 2222 -o "AddressFamily inet"'
    tty: false

